{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-code.sh",
            "timeout": 120,
            "statusMessage": "Type checking and linting..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(npm run lint)", "Bash(npx eslint .)", "Bash(npx tsc -b)"]
  }
}
